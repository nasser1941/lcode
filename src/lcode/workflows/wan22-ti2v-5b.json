{
  "source": "ComfyUI's template video_wan2_2_5B_ti2v, in API format",
  "negative_note": "Wan's own default negative prompt (Chinese): oversaturated, overexposed, static, blurry details, subtitles, worst quality, extra fingers, deformed limbs, cluttered background, walking backwards…",
  "defaults": {
    "width": 1280,
    "height": 704,
    "length": 121,
    "fps": 24,
    "steps": 20,
    "negative": "色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走"
  },
  "labels": {
    "1": "loading the model",
    "2": "loading the text encoder",
    "3": "loading the VAE",
    "5": "reading the prompt",
    "6": "reading the prompt",
    "7": "preparing the frames",
    "8": "drawing the frames",
    "9": "decoding the frames",
    "10": "making the video",
    "11": "saving"
  },
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "$model",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "$text_encoder",
        "type": "wan",
        "device": "default"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "$vae"
      }
    },
    "4": {
      "class_type": "ModelSamplingSD3",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "shift": 8
      }
    },
    "5": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "$prompt",
        "clip": [
          "2",
          0
        ]
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "$negative",
        "clip": [
          "2",
          0
        ]
      }
    },
    "7": {
      "class_type": "Wan22ImageToVideoLatent",
      "inputs": {
        "vae": [
          "3",
          0
        ],
        "width": "$width",
        "height": "$height",
        "length": "$length",
        "batch_size": 1
      }
    },
    "8": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "4",
          0
        ],
        "seed": "$seed",
        "steps": "$steps",
        "cfg": 5,
        "sampler_name": "uni_pc",
        "scheduler": "simple",
        "positive": [
          "5",
          0
        ],
        "negative": [
          "6",
          0
        ],
        "latent_image": [
          "7",
          0
        ],
        "denoise": 1
      }
    },
    "9": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "8",
          0
        ],
        "vae": [
          "3",
          0
        ]
      }
    },
    "10": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": [
          "9",
          0
        ],
        "fps": "$fps"
      }
    },
    "11": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": [
          "10",
          0
        ],
        "filename_prefix": "lcode/video",
        "format": "mp4",
        "codec": "auto"
      }
    }
  }
}
