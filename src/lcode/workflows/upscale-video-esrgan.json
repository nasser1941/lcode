{
  "source": "ComfyUI's template utility-gan_upscaler, in API format",
  "defaults": {
    "scale_by": 0.5,
    "fps": 24
  },
  "labels": {
    "1": "loading the clip",
    "2": "reading its frames",
    "3": "loading the upscaler",
    "4": "upscaling the frames",
    "5": "resizing",
    "6": "making the video",
    "7": "saving"
  },
  "graph": {
    "1": {
      "class_type": "LoadVideo",
      "inputs": {
        "file": "$video"
      }
    },
    "2": {
      "class_type": "GetVideoComponents",
      "inputs": {
        "video": [
          "1",
          0
        ]
      }
    },
    "3": {
      "class_type": "UpscaleModelLoader",
      "inputs": {
        "model_name": "$model"
      }
    },
    "4": {
      "class_type": "ImageUpscaleWithModel",
      "inputs": {
        "upscale_model": [
          "3",
          0
        ],
        "image": [
          "2",
          0
        ]
      }
    },
    "5": {
      "class_type": "ImageScaleBy",
      "inputs": {
        "image": [
          "4",
          0
        ],
        "upscale_method": "lanczos",
        "scale_by": "$scale_by"
      }
    },
    "6": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": [
          "5",
          0
        ],
        "audio": [
          "2",
          1
        ],
        "fps": "$fps"
      }
    },
    "7": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": [
          "6",
          0
        ],
        "filename_prefix": "lcode/video",
        "format": "mp4",
        "codec": "auto"
      }
    }
  }
}
